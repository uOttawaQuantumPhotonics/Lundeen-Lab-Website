	author = {Smith, Brian J. and Mahou, P. and Cohen, Offir and Lundeen, Jeff S. and Walmsley, I. A.},
	month = dec,
	year = {2009},
	note = {Publisher: Optica Publishing Group},
	pages = {23589--23602},
}

@patent{steinberg_quantum-interferometrically_2003,
