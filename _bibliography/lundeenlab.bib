	month = mar,
	year = {2017},
	note = {Number: 7647
Publisher: Nature Publishing Group},
	keywords = {Chemistry, Energy harvesting, Physical chemistry},
	pages = {647--656},
}

@article{sit_general_2017,
	title = {General lossless spatial polarization transformations},
	volume = {19},
	issn = {2040-8986},
